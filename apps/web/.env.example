# Server-side only — NEVER prefix with NEXT_PUBLIC (that would ship the value to the browser).
# The web app talks to the API through its own /api/bff proxy, which attaches the token server-side.

# Where the Next.js app is reachable (used to build OIDC redirect URIs).
APP_URL=http://localhost:3000

# The .NET API base the BFF proxy forwards to (server-to-server).
DESK_API_BASE=http://localhost:5080

# Keycloak OIDC. desk-web is a PUBLIC client using PKCE — no client secret.
KEYCLOAK_ISSUER=http://localhost:8081/realms/desk
KEYCLOAK_CLIENT_ID=desk-web
# KEYCLOAK_CLIENT_SECRET=   # only if you switch desk-web to a confidential client

# No-Docker demo: set this AND run the API with LocalMode__Enabled=true. The login page then skips
# Keycloak (which isn't running) and the header shows the auto-signed-in demo admin.
# NEXT_PUBLIC_LOCAL_MODE=true
