# Copy to .env.prod and fill in. NEVER commit the real .env.prod.
# Every value marked change-me must actually change — the stack refuses to start on empty ones.

# The public hostname. DNS A records for BOTH of these must point at the Docker host:
#   piomanage.com          -> web app
#   auth.piomanage.com     -> Keycloak sign-in
PUBLIC_HOST=piomanage.com

POSTGRES_USER=desk
POSTGRES_PASSWORD=change-me-strong

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong
# Leave empty for a public PKCE client (the imported realm's desk-web client).
KEYCLOAK_CLIENT_SECRET=

# Vault dev-mode root token (testing tier). Rotate + move to server-mode Vault before real load.
VAULT_TOKEN=change-me-strong

# HMAC key for signed attachment-download URLs. Any long random string.
ATTACHMENT_SIGNING_KEY=change-me-long-random

# The first MSP administrator. Created unlinked; they sign in through Keycloak with this email
# (create the same user in Keycloak's desk realm) and the account binds on first login.
BOOTSTRAP_ADMIN_EMAIL=proapps@techpio.com
BOOTSTRAP_ADMIN_NAME=Harpal Singh
BOOTSTRAP_ORG_NAME=TechPio
BOOTSTRAP_ORG_SLUG=techpio

# Scheduled sync interval in minutes (Autotask meters API requests per hour).
SYNC_POLL_MINUTES=5

# Public exposure without a VPS: create a free Cloudflare account, move the domain's nameservers
# to Cloudflare, create a remotely-managed Tunnel (Zero Trust -> Networks -> Tunnels) and paste its
# token here. Then run compose with --profile tunnel instead of --profile edge.
TUNNEL_TOKEN=
